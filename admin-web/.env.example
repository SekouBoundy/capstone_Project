# The admin panel reads the repository root .env directly (see `envDir` in
# vite.config.ts), so this file is a reference, not a second place to keep
# credentials in sync.
#
# These names match the Expo app's variables. If your root .env already
# has them, the panel works with no extra setup.

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
